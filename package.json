{
  "name": "breeze-plugin-jm-comic",
  "version": "0.0.11",
  "type": "module",
  "packageManager": "pnpm@12.5.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && node --import tsx build/generate-version.ts && node --import tsx build/generate-manifest.ts && cross-env NODE_OPTIONS=\"--import tsx\" rspack build && node --import tsx build/generate-brotli.ts",
    "dev": "pnpm dev:serve",
    "dev:serve": "tsx dev-server.ts"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "breeze-plugin-kit": "^0.12.0"
  },
  "devDependencies": {
    "@rspack/cli": "^2.2.7",
    "@rspack/core": "^2.2.7",
    "@types/node": "^25.9.8",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
