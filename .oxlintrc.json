{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc"
  ],
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "verison/**",
    "build/**/*.cjs",
    "docs/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {},
  "env": {
    "builtin": true
  }
}
